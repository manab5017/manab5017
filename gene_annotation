submit_uniprot_job <- function(
    ids,
    from_db = "Ensembl",
    to_db = "UniProtKB"
) {

  response <- tryCatch(

    POST(
      "https://rest.uniprot.org/idmapping/run",

      body = list(
        from = from_db,
        to = to_db,
        ids = paste(
          ids,
          collapse = ","
        )
      ),

      encode = "form"
    ),

    error = function(e) {
      NULL
    }
  )

  if (is.null(response)) {
    return(NULL)
  }

  if (status_code(response) != 200) {

    cat(
      "UniProt submission failed. HTTP:",
      status_code(response),
      "\n"
    )

    return(NULL)
  }

  result <- content(
    response,
    as = "parsed",
    type = "application/json"
  )

  if (is.null(result$jobId)) {
    return(NULL)
  }

  result$jobId
}


############################################################
# 12. GET UNIPROT RESULTS
############################################################

get_uniprot_results <- function(
    job_id,
    max_attempts = 30,
    wait_seconds = 3
) {

  status_url <- paste0(
    "https://rest.uniprot.org/idmapping/status/",
    job_id
  )

  for (attempt in seq_len(max_attempts)) {

    Sys.sleep(wait_seconds)

    response <- tryCatch(

      GET(
        status_url
      ),

      error = function(e) {
        NULL
      }
    )

    if (is.null(response)) {
      next
    }

    if (status_code(response) != 200) {
      next
    }

    status <- content(
      response,
      as = "parsed",
      type = "application/json"
    )

    if (!is.null(status$jobStatus)) {

      cat(
        "Job status:",
        status$jobStatus,
        "\n"
      )

      if (
        status$jobStatus == "RUNNING" ||
        status$jobStatus == "NEW"
      ) {

        next
      }

      if (
        status$jobStatus == "FAILED"
      ) {

        return(NULL)
      }
    }

    if (
      !is.null(status$results) ||
      !is.null(status$redirectURL)
    ) {

      break
    }
  }


  result_url <- paste0(
    "https://rest.uniprot.org/idmapping/uniprotkb/results/",
    job_id,
    "?format=tsv"
  )


  response <- tryCatch(

    GET(
      result_url
    ),

    error = function(e) {
      NULL
    }
  )


  if (is.null(response)) {
    return(NULL)
  }


  if (status_code(response) != 200) {

    cat(
      "Failed to download UniProt results. HTTP:",
      status_code(response),
      "\n"
    )

    return(NULL)
  }


  txt <- content(
    response,
    as = "text",
    encoding = "UTF-8"
  )


  if (
    is.null(txt) ||
    nchar(txt) == 0
  ) {

    return(NULL)
  }


  result <- tryCatch(

    read.delim(
      text = txt,
      stringsAsFactors = FALSE,
      check.names = FALSE
    ),

    error = function(e) {
      NULL
    }
  )


  result
}


