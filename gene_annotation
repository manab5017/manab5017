run_kegg <- function(
    gene_list,
    universe
) {

  if (
    length(gene_list) < 5
  ) {

    return(NULL)
  }


  result <- tryCatch(

    enrichKEGG(

      gene = gene_list,

      universe = universe,

      organism = "hsa",

      keyType = "ncbi-geneid",

      pAdjustMethod = "BH",

      pvalueCutoff = 0.05,

      qvalueCutoff = 0.05
    ),

    error = function(e) {

      cat(
        "KEGG error:",
        e$message,
        "\n"
      )

      NULL
    }
  )


  result
}


