############################################################
# 26. GO ENRICHMENT FUNCTION
############################################################

run_go <- function(
    gene_list,
    universe,
    ontology
) {

  if (
    length(gene_list) < 5
  ) {

    return(NULL)
  }


  result <- tryCatch(

    enrichGO(

      gene = gene_list,

      universe = universe,

      OrgDb = org.Hs.eg.db,

      keyType = "ENTREZID",

      ont = ontology,

      pAdjustMethod = "BH",

      pvalueCutoff = 0.05,

      qvalueCutoff = 0.05,

      readable = TRUE
    ),

    error = function(e) {

      cat(
        "GO error:",
        e$message,
        "\n"
      )

      NULL
    }
  )


  result
}


