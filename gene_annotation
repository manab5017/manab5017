  plot_data,
  aes(
    x = log2FoldChange,
    y = neg_log10_padj,
    color = PlotGroup
  )
) +

  geom_point(
    alpha = 0.65,
    size = 2
  ) +

  geom_vline(
    xintercept = c(-1, 1),
    linetype = "dashed"
  ) +

  geom_hline(
    yintercept = -log10(0.05),
    linetype = "dashed"
  ) +

  geom_text_repel(
    data = top_labels,
