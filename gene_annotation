############################################################
# 14. SPLIT IDS INTO SMALL BATCHES
############################################################

batch_size <- 25

id_batches <- split(
  uniprot_ids,
  ceiling(
    seq_along(uniprot_ids) /
      batch_size
  )
)

cat(
  "Number of UniProt batches:",
  length(id_batches),
  "\n"
)


############################################################
# 15. RUN UNIPROT MAPPING
############################################################

# IMPORTANT:
# Preallocate list.
# This avoids the previous invalid syntax:
#
# uniprot_results[
#   [length(uniprot_results) + 1]
# ]
#
# The correct approach is:
#
# uniprot_results[[i]] <- result
############################################################

uniprot_results <- vector(
  "list",
  length(id_batches)
)


for (i in seq_along(id_batches)) {

  cat(
    "\n-----------------------------------\n"
  )

  cat(
    "UniProt batch:",
    i,
    "/",
    length(id_batches),
    "\n"
  )

  ids <- id_batches[[i]]


  job_id <- NULL


  for (retry in 1:3) {

    cat(
      "Submission attempt:",
      retry,
      "\n"
    )

    job_id <- submit_uniprot_job(
      ids
    )

    if (!is.null(job_id)) {
      break
    }

    Sys.sleep(5)
  }


  if (is.null(job_id)) {

    cat(
      "Batch",
      i,
      "could not be submitted.\n"
    )

    next
  }


  cat(
    "Job ID:",
    job_id,
    "\n"
  )


  result <- get_uniprot_results(
    job_id
  )


  if (
    !is.null(result) &&
    nrow(result) > 0
  ) {

    uniprot_results[[i]] <- result

    cat(
      "Mapped records:",
      nrow(result),
      "\n"
    )

  } else {

    cat(
      "No mapping results returned.\n"
    )
  }


  Sys.sleep(2)
}


