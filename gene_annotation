    PlotGroup = case_when(

      padj < 0.05 &
        log2FoldChange >= 1 ~
        "Higher in Control",

      padj < 0.05 &
        log2FoldChange <= -1 ~
        "Higher in Cancer",

      TRUE ~
        "Not Significant"
    )
  )


top_labels <- plot_data %>%
  filter(
    PlotGroup != "Not Significant"
  ) %>%
  arrange(
    padj
  ) %>%
  slice_head(
    n = 15
  )


