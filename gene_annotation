make_go_dotplot <- function(
    go_object,
    filename,
    title
) {

  if (
    is.null(go_object)
  ) {
    return(NULL)
  }


  if (
    nrow(
      as.data.frame(go_object)
    ) == 0
  ) {

    return(NULL)
  }


  p <- dotplot(
    go_object,
    showCategory = 15
  ) +

    ggtitle(
      title
    ) +

    theme_classic(
      base_size = 13
    ) +

    theme(
      plot.title = element_text(
        face = "bold"
      )
    )


  ggsave(
    filename,
    p,
    width = 10,
    height = 8,
    dpi = 600
  )
}


